{
  "multipart": [
    {
      "apply": {
        "model": "mekanism:block/transmitter/ultimate_mechanical_pipe_center"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "mekanism:block/transmitter/ultimate_mechanical_pipe_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "mekanism:block/transmitter/ultimate_mechanical_pipe_up"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "mekanism:block/transmitter/ultimate_mechanical_pipe_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "mekanism:block/transmitter/ultimate_mechanical_pipe_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "mekanism:block/transmitter/ultimate_mechanical_pipe_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "mekanism:block/transmitter/ultimate_mechanical_pipe_east"
      }
    }
  ]
}
